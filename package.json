{
  "name": "cts-office",
  "version": "0.6.0",
  "description": "CTS Office: A 3D IT Office & Co-living workspace for Antigravity (Gemini), Claude Code & GitHub Actions sessions, with live Mac monitoring and one-click cleanup.",
  "author": "MichelDevWeb (https://github.com/MichelDevWeb)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/MichelDevWeb/cts-office.git"
  },
  "homepage": "https://github.com/MichelDevWeb/cts-office#readme",
  "bugs": {
    "url": "https://github.com/MichelDevWeb/cts-office/issues"
  },
  "keywords": [
    "cts-office",
    "antigravity",
    "gemini",
    "claude-code",
    "claude",
    "github-actions",
    "ai-agents",
    "dashboard",
    "office",
    "3d",
    "threejs",
    "codex",
    "developer-tools"
  ],
  "type": "module",
  "bin": {
    "cts-office": "bin/cli.mjs",
    "my-office": "bin/cli.mjs"
  },
  "files": [
    "bin/",
    "server/",
    "hooks/",
    "src/i18n/",
    "src/shared/",
    "menubar/",
    "vscode-extension/",
    "public/",
    "next.config.mjs",
    ".next/",
    "!.next/cache/",
    "!.next/dev/",
    "!.next/trace",
    "!.next/trace-build",
    "!.next/diagnostics/",
    "!.next/types/"
  ],
  "scripts": {
    "dev": "node server/index.mjs --dev",
    "build": "next build",
    "start": "NODE_ENV=production node server/index.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --test",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test --grep @smoke",
    "smoke": "node scripts/smoke.mjs",
    "doctor": "node bin/cli.mjs doctor",
    "prepack": "node scripts/prepack.mjs"
  },
  "engines": {
    "node": ">=20.9"
  },
  "dependencies": {
    "next": "16.4.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "three": "0.160.0"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "22.18.12",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "eslint": "9.38.0",
    "eslint-config-next": "16.4.3",
    "gifenc": "1.0.3",
    "pngjs": "7.0.0",
    "typescript": "5.9.3"
  }
}
